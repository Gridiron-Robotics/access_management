# Example environment for the Contract-A MCP sidecar (docker-compose.mcp.yml).
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# real secrets. These are the inputs `docker compose -f docker-compose.mcp.yml`
# reads.

# REQUIRED. The bearer that authenticates every "who may do what" question in
# the estate. The sidecar refuses to start without it (there is no default).
# The consuming agent platform must present the same value:
#   GATEWAY_TOKENS={"http://access-management-mcp:8085":"<ACCESS_MCP_TOKEN>"}
ACCESS_MCP_TOKEN=

# The PDP the sidecar forwards decisions to. Defaults to the estate service name
# on the shared network; override only if the PDP container is named differently.
CERBOS_PDP_URL=http://access-management:3592

# Observability. service.name must equal the OpenObserve stream name so a PDP
# outage opens the self-heal incident under this name.
OTEL_SERVICE_NAME=access_management

# Optional: where to export OTLP traces / error logs.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve-collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=
