            ],
            "resource": {
              "attr": {
                "approval_ref": "",
                "approved_by_human": false,
                "destructive": true,
                "module": "warehouse_placement",
                "tenant_id": "acme"
              },
              "id": "placement.release_stock",
              "kind": "mcp_tool"
            }
          }
        ]
      },
      "settings": {
        "TENANT_CLAIM_ENFORCE": true
      }
    },
    {
      "approval_lookup": null,
      "call": {
        "actor": "aud",
