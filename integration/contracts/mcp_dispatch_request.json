{
  "_contract": "The MCP dispatch request the erp_django_middleware PEP sends to the PDP (mcp_gateway/authz.py authorize_dispatch). Byte-identical copies: access_management integration/contracts/mcp_dispatch_request.json and erp_django_middleware django_middleware/tests/unit/mcp_gateway/fixtures/mcp_dispatch_request.json. The middleware's test asserts its builder emits each `request` from each `call`; access_management's tests assert policies/agent/testdata holds each request's principal/resource and gateway_dispatch_test.yaml decides `expected`. Change both repos together.",
  "examples": [
    {
      "approval_lookup": {
        "approval_ref": "41",
        "approved": true,
        "approved_by_human": true
      },
      "call": {
        "actor": "otto",
        "approval_token": "appr-token-1",
        "destructive": true,
        "module": "warehouse_placement",
        "roles": [
          "OPS",
          "STAFF"
        ],
        "tenant_id": "acme",
        "token_tenants": [
          "globex",
          "acme"
        ],
        "tool": "placement.release_stock"
      },
      "expected": {
        "dispatch": "EFFECT_ALLOW"
      },
      "name": "gw_ops_release_approved",
      "note": "OPS, own tenant, destructive tool with a recorded approval (the approval row lookup is stubbed to ref 41).",
      "request": {
        "principal": {
          "attr": {
            "tenant_claim_enforce": true,
            "tenants": [
              "acme",
              "globex"
            ]
          },
          "id": "otto",
          "roles": [
            "OPS",
            "STAFF"
          ]
        },
        "resources": [
          {
            "actions": [
              "dispatch"
            ],
            "resource": {
              "attr": {
                "approval_ref": "41",
                "approved": true,
                "approved_by_human": true,
                "destructive": true,
                "module": "warehouse_placement",
                "tenant_id": "acme"
              },
              "id": "placement.release_stock",
              "kind": "mcp_tool"
            }
          }
        ]
      },
      "settings": {
        "TENANT_CLAIM_ENFORCE": true
      }
    },
    {
      "approval_lookup": null,
      "call": {
        "actor": "otto",
        "approval_token": "",
        "destructive": true,
        "module": "warehouse_placement",
        "roles": [
          "OPS",
          "STAFF"
        ],
        "tenant_id": "acme",
        "token_tenants": [
          "globex",
          "acme"
        ],
        "tool": "placement.release_stock"
      },
      "expected": {
        "dispatch": "EFFECT_DENY"
      },
      "name": "gw_ops_release_unapproved",
      "note": "The same call with no approval token: the middleware sends NO `approved` key.",
      "request": {
        "principal": {
          "attr": {
            "tenant_claim_enforce": true,
            "tenants": [
              "acme",
              "globex"
            ]
          },
