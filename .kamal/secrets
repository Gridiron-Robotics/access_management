# Kamal secrets. This file is committed as a TEMPLATE only.
#
# DO NOT put real secret values here. Each entry below is interpolated from your
# shell environment (CI secrets, a vault, 1Password, etc.) at deploy time, e.g.:
#
#   export KAMAL_REGISTRY_PASSWORD=ghp_xxx
#   bundle exec kamal deploy
#
# Docs: https://kamal-deploy.org/docs/commands/secrets/
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Contract-A MCP sidecar (accessories.mcp in config/deploy.yml). Both are declared
# under accessories.mcp env.secret, so Kamal must be able to resolve them here or
# the accessory deploy aborts. The bearer guards the estate's authorization model;
# it must never sit in env.clear. Templates only — export the real values in your
# shell / CI before `bundle exec kamal deploy`.
ACCESS_MCP_TOKEN=$ACCESS_MCP_TOKEN
OTEL_EXPORTER_OTLP_HEADERS=$OTEL_EXPORTER_OTLP_HEADERS

# Cerbos Hub mode (used only by `kamal deploy -d hub`; see integration/CERBOS_HUB.md).
# Empty unless you export them; the default disk-mode deploy never references these.
CERBOS_HUB_CLIENT_ID=$CERBOS_HUB_CLIENT_ID
CERBOS_HUB_CLIENT_SECRET=$CERBOS_HUB_CLIENT_SECRET
CERBOS_HUB_WORKSPACE_SECRET=$CERBOS_HUB_WORKSPACE_SECRET
